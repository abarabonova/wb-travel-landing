# Builder
FROM harbor.wildberries.ru/devops/ci/base-images/node:22-alpine3.23 AS build

WORKDIR /app

COPY .npmrc package.json package-lock.json ./
RUN npm ci --no-fund --no-audit

COPY . .
RUN npm run build

# Nginx
FROM harbor.wildberries.ru/docker-hub-proxy/library/nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html

WORKDIR /usr/share/nginx/html
EXPOSE 8080
